<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="fleet_vehicle_maintenance_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.maintenance.form</field>
        <field name="model">fleet.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <form string="Vehicle Maintenance">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_done" string="Mark Done" type="object" invisible="state not in ['draft', 'scheduled']" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'scheduled']" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="maintenance_category"/>
                        </group>
                        <group>
                            <field name="service_type_id"/>
                            <field name="service_category"/>
                            <field name="priority"/>
                            <field name="vendor_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                        </group>
                        <group>
                            <field name="parts_cost" widget="monetary" readonly="1"/>
                            <field name="labor_cost" widget="monetary"/>
                            <field name="other_cost" widget="monetary"/>
                            <field name="total_cost" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="odometer"/>
                            <field name="previous_odometer"/>
                            <field name="duration_hours"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="warranty_number"/>
                            <field name="warranty_end_date"/>
                            <field name="warranty_remaining_days" readonly="1"/>
                        </group>
                        <group>
                            <field name="planned_date"/>
                            <field name="next_service_date"/>
                            <field name="service_location"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="fleet_vehicle_maintenance_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.maintenance.tree</field>
        <field name="model">fleet.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <list string="Vehicle Maintenance">
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="maintenance_category"/>
                <field name="service_category"/>
                <field name="odometer"/>
                <field name="total_cost" widget="monetary"/>
                <field name="priority"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="fleet_vehicle_maintenance_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.maintenance.search</field>
        <field name="model">fleet.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="maintenance_category"/>
                <field name="vendor_id"/>
                <field name="service_category"/>
                <field name="company_id"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Scheduled" name="scheduled" domain="[('state','=','scheduled')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <group expand="1" string="Group By">
                    <filter string="Vehicle" name="group_by_vehicle_id" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Maintenance Category" name="group_by_maintenance_category" context="{'group_by': 'maintenance_category'}"/>
                    <filter string="Service Category" name="group_by_service_category" context="{'group_by': 'service_category'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Graph View -->
    <record id="fleet_vehicle_maintenance_graph" model="ir.ui.view">
        <field name="name">fleet.vehicle.maintenance.graph</field>
        <field name="model">fleet.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Analytics" type="bar">
                <field name="maintenance_category" type="row"/>
                <field name="total_cost" type="measure"/>
                <field name="odometer" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="fleet_vehicle_maintenance_pivot" model="ir.ui.view">
        <field name="name">fleet.vehicle.maintenance.pivot</field>
        <field name="model">fleet.vehicle.maintenance</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Performance">
                <field name="vehicle_id" type="row"/>
                <field name="maintenance_category" type="col"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="fleet_vehicle_maintenance_action" model="ir.actions.act_window">
        <field name="name">Vehicle Maintenance</field>
        <field name="res_model">fleet.vehicle.maintenance</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="fleet_vehicle_maintenance_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_smiling_face">Create your first maintenance record.</p>
        </field>
    </record>

    <!-- Analytics Action -->
    <record id="fleet_vehicle_maintenance_analytics_action" model="ir.actions.act_window">
        <field name="name">Maintenance Analytics</field>
        <field name="res_model">fleet.vehicle.maintenance</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="fleet_vehicle_maintenance_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_smiling_face">Analyze maintenance costs and categories.</p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_fleet_vehicle_maintenance" name="Maintenance" parent="menu_fleet_root" action="fleet_vehicle_maintenance_action" sequence="10"/>
    <menuitem id="menu_fleet_maintenance_analytics" name="Maintenance Analytics" parent="menu_fleet_analytics" action="fleet_vehicle_maintenance_analytics_action" sequence="10"/>
</odoo>
