<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="fleet_vehicle_rate_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.rate.form</field>
        <field name="model">fleet.vehicle.rate</field>
        <field name="arch" type="xml">
            <form string="Vehicle Rate">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vehicle_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="rate_per_km"/>
                            <field name="rate_per_hour"/>
                        </group>
                        <group>
                            <field name="daily_rate"/>
                            <field name="fixed_rate"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="fuel_included"/>
                            <field name="driver_included"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="fleet_vehicle_rate_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.rate.tree</field>
        <field name="model">fleet.vehicle.rate</field>
        <field name="arch" type="xml">
            <list string="Vehicle Rates">
                <field name="vehicle_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="rate_per_km" widget="monetary"/>
                <field name="rate_per_hour" widget="monetary"/>
                <field name="daily_rate" widget="monetary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="fleet_vehicle_rate_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.rate.search</field>
        <field name="model">fleet.vehicle.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <group expand="1" string="Group By">
                    <filter string="Vehicle" name="group_by_vehicle_id" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="fleet_vehicle_rate_action" model="ir.actions.act_window">
        <field name="name">Vehicle Rates</field>
        <field name="res_model">fleet.vehicle.rate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fleet_vehicle_rate_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_smiling_face">Create your first vehicle rate.</p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_fleet_vehicle_rate" name="Rates" parent="menu_fleet_root" action="fleet_vehicle_rate_action" sequence="30"/>
</odoo>
